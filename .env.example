# Copy to .env and fill in. .env is gitignored; keep it that way.

# Postgres store for parsed OpenAPI specs and findings
HOST=localhost
PORT=5432
USERNAME=postgres
PASSWORD=
DB_NAME=openapi_store

# The API under analysis
QA_ENDPOINT=https://qa-api.example.com
OPENAPI_SPEC_PRIMARY=https://api.example.com/openapi.json
OPENAPI_SPEC_SECONDARY=https://api.example.com/openapi-modular.json
AUTHORIZATION_TOKEN=

# Slack reporting (optional; leave blank to disable)
SLACK_WEBHOOK_URL=
SLACK_TOKEN=
CHANNEL_ID=

# Field names that look like PII but are not. EXACT names, matched
# case-insensitively — not regexes. The values below used to be written as
# regexes (`user_?id$`), which matched nothing at all, so the setting appeared
# to work and suppressed no false positives whatsoever.
#
# Exact matching is deliberate: a loose entry of `id` would also match inside
# tax_id, passport_id and national_id, hiding government identifiers behind a
# setting meant to reduce noise.
# Tune this first when you are drowning in false positives.
NON_PII_FIELDS=["user_id","device_id","session_id","id","uuid"]
